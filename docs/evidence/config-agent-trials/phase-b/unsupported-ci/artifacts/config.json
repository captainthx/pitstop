{
  "schemaVersion": 2,
  "runner": {
    "image": "python:3.13-slim-bookworm",
    "architecture": "linux/arm64"
  },
  "jobs": ["verify"],
  "checks": [
    {
      "id": "verify",
      "steps": [
        {
          "id": "install",
          "name": "Install declared Python test dependencies",
          "run": "python -m pip install --requirement requirements-dev.txt"
        },
        {
          "id": "test",
          "name": "Run reviewed Python tests",
          "run": "python -m pytest"
        }
      ]
    }
  ]
}
